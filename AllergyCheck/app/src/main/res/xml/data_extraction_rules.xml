<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="llm/" />
        <exclude domain="file" path="llm/" />
        <exclude domain="sharedpref" path="local_model.xml" />
        <!-- Scan history is health-adjacent and stays on the device. -->
        <exclude domain="file" path="history/" />
        <exclude domain="database" path="scan_history.db" />
        <exclude domain="database" path="scan_history.db-wal" />
        <exclude domain="database" path="scan_history.db-shm" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="llm/" />
        <exclude domain="file" path="llm/" />
        <exclude domain="sharedpref" path="local_model.xml" />
        <!-- Scan history is health-adjacent and stays on the device. -->
        <exclude domain="file" path="history/" />
        <exclude domain="database" path="scan_history.db" />
        <exclude domain="database" path="scan_history.db-wal" />
        <exclude domain="database" path="scan_history.db-shm" />
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
