<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="external" path="llm/" />
    <exclude domain="file" path="llm/" />
    <exclude domain="sharedpref" path="local_model.xml" />
    <exclude domain="sharedpref" path="analysis_credentials.xml" />
    <!-- Scan history is health-adjacent and stays on the device. -->
    <exclude domain="file" path="history/" />
    <exclude domain="database" path="scan_history.db" />
    <exclude domain="database" path="scan_history.db-wal" />
    <exclude domain="database" path="scan_history.db-shm" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
