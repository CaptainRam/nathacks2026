<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        style="@style/Widget.AllergyCheck.SettingsSectionTitle"
        android:text="@string/detection_settings_title" />

    <com.google.android.material.textview.MaterialTextView
        style="@style/Widget.AllergyCheck.SettingsSectionHint"
        android:text="@string/detection_location_hint" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.AllergyCheck.SettingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RadioGroup
                android:id="@+id/detection_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:saveEnabled="false">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_location_local"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_local" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_location_cloud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_cloud" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/detection_local_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_matching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_matching" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_local_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_local_ai" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/detection_cloud_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:visibility="gone">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_openrouter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_openrouter" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_decisions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_decisions" />
            </RadioGroup>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/detection_mode_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/detection_cloud_configuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.AllergyCheck.SettingsSectionHint"
                    android:layout_marginTop="12dp"
                    android:text="@string/detection_cloud_hint" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_api_key_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/detection_api_key"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_model_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_model_id"
                    app:helperText="@string/detection_model_id_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_model_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_decisions_model_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_decisions_model_id"
                    app:helperText="@string/detection_model_id_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_decisions_model_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_threshold_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_threshold">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_threshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_concurrency_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_concurrency"
                    app:helperText="@string/detection_concurrency_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_concurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detection_save_cloud"
                    style="@style/Widget.AllergyCheck.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/detection_save_cloud" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detection_cloud_save_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/detection_cloud_saved"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
