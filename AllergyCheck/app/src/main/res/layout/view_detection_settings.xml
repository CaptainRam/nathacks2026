<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        style="@style/Widget.AllergyCheck.SettingsSectionTitle"
        android:text="@string/detection_settings_title" />

    <com.google.android.material.textview.MaterialTextView
        style="@style/Widget.AllergyCheck.SettingsSectionHint"
        android:text="@string/detection_location_hint" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.AllergyCheck.SettingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Where the check runs; the options below change with it. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/detection_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/detection_location_label"
                android:saveEnabled="false"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detection_location_local"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_local"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detection_location_cloud"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/detection_cloud"
                    android:textAllCaps="false" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Each option carries its own two-line label, set in code. -->
            <RadioGroup
                android:id="@+id/detection_local_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:saveEnabled="false">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_matching"
                    style="@style/Widget.AllergyCheck.DetectionModeOption" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_local_ai"
                    style="@style/Widget.AllergyCheck.DetectionModeOption" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/detection_cloud_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:saveEnabled="false"
                android:visibility="gone">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_openrouter"
                    style="@style/Widget.AllergyCheck.DetectionModeOption" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/detection_mode_decisions"
                    style="@style/Widget.AllergyCheck.DetectionModeOption" />
            </RadioGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cloud connection: its own section, like the local model below for Local. -->
    <LinearLayout
        android:id="@+id/detection_cloud_configuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.AllergyCheck.SettingsSectionTitle"
            android:layout_marginTop="24dp"
            android:text="@string/detection_cloud_title" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.AllergyCheck.SettingsSectionHint"
            android:text="@string/detection_cloud_hint" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AllergyCheck.SettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_api_key_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/detection_api_key"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/detection_api_key_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_model_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_model_id"
                    app:helperText="@string/detection_model_id_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_model_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_decisions_model_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_decisions_model_id"
                    app:helperText="@string/detection_model_id_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_decisions_model_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_threshold_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_threshold"
                    app:helperText="@string/detection_threshold_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_threshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detection_concurrency_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/detection_concurrency"
                    app:helperText="@string/detection_concurrency_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detection_concurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Saved / needs-a-key state, read before the button. -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detection_cloud_save_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detection_save_cloud"
                    style="@style/Widget.AllergyCheck.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/detection_save_cloud" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
