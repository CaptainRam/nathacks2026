<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:minHeight="64dp"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/settings"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:titleTextColor="?attr/colorOnSurface" />

    <!-- The section switch stays pinned under the toolbar while the content scrolls. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/settings_section_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/settings_sections"
            app:checkedButton="@id/section_allergens_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="520dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/section_allergens_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/settings_section_allergens"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/section_model_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/settings_section_model"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Shown only once the content scrolls under the pinned header. -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/settings_header_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:dividerColor="?attr/colorOutlineVariant" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="520dp">

                <!-- Allergens: edited as a draft and kept only when saved. -->
                <LinearLayout
                    android:id="@+id/allergen_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.AllergyCheck.SettingsSectionTitle"
                        android:text="@string/allergens_title" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.AllergyCheck.SettingsSectionHint"
                        android:text="@string/allergens_hint" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.AllergyCheck.SettingsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/allergen_options_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="0dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.AllergyCheck.SettingsSectionTitle"
                        android:layout_marginTop="24dp"
                        android:text="@string/results_settings_title" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.AllergyCheck.SettingsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/show_not_detected_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/show_not_detected"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/show_not_detected_hint"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/show_not_detected_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/show_not_detected" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Detection location and models. -->
                <LinearLayout
                    android:id="@+id/model_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/view_detection_settings" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/local_model_title"
                        style="@style/Widget.AllergyCheck.SettingsSectionTitle"
                        android:layout_marginTop="24dp"
                        android:text="@string/model_settings_title" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/local_model_hint"
                        style="@style/Widget.AllergyCheck.SettingsSectionHint"
                        android:text="@string/model_settings_section_hint" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/local_model_section"
                        style="@style/Widget.AllergyCheck.SettingsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:text="@string/model_settings_name"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Always shown so the header row never shifts; only its text changes. -->
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/model_availability"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:accessibilityLiveRegion="polite"
                                    android:background="@drawable/bg_pill"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/model_settings_missing"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/model_settings_summary"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/model_download_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:accessibilityLiveRegion="polite"
                                android:text="@string/model_settings_not_downloaded"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/model_download_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:contentDescription="@string/model_settings_title"
                                android:max="100"
                                android:visibility="gone"
                                app:trackCornerRadius="2dp"
                                app:trackThickness="4dp" />

                            <!-- Read before the download button, not hidden behind Details. -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/model_terms_link"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:linksClickable="true"
                                android:text="@string/model_settings_terms"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textColorLink="?attr/colorPrimary" />

                            <!-- Only one of Download/Retry or Delete shows at a time. -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/model_download_button"
                                    style="@style/Widget.AllergyCheck.PrimaryButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:text="@string/model_settings_download" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/model_delete_button"
                                    style="@style/Widget.AllergyCheck.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:enabled="false"
                                    android:minHeight="48dp"
                                    android:text="@string/model_settings_delete"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                app:dividerColor="?attr/colorOutlineVariant" />

                            <!-- Its own row, so large text can never squeeze the primary action. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/model_details_button"
                                style="@style/Widget.AllergyCheck.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="-12dp"
                                android:layout_marginTop="4dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/model_settings_details"
                                app:icon="@drawable/ic_expand_more"
                                app:iconGravity="end"
                                app:iconPadding="4dp"
                                app:iconSize="20dp" />

                            <LinearLayout
                                android:id="@+id/model_details"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/model_settings_description"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/model_download_source"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:linksClickable="true"
                                    android:text="@string/model_settings_source"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textColorLink="?attr/colorPrimary" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Page-wide: one Save stores the allergen draft and the AI model cloud fields. -->
    <LinearLayout
        android:id="@+id/settings_save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="?attr/colorOutlineVariant" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="520dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/selection_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/no_allergens_selected"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Model section only. Not a live region: it changes with the tab, not with an edit. -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/model_save_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/detection_saves_allergen_draft"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_preferences_button"
                    style="@style/Widget.AllergyCheck.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
