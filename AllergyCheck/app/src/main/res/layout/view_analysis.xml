<?xml version="1.0" encoding="utf-8"?>
<!-- The in-page check: progress while the label is read, then the result. Sits under the photo
     strip in activity_main and replaces the hero, tips and photo card while it is shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/analysis_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/photo_strip_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/tap_photo_to_change"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Progress -->
    <LinearLayout
        android:id="@+id/analysis_loading"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Determinate: ScanProgress fills it through reading the label and, in the AI modes,
             the AI checks, so every detection mode shows how far the scan has got. Wavy as in M3
             Expressive: the spec's 1.6dp amplitude and 15dp wavelength at 48dp, scaled to 56dp,
             with the wave drifting so a ring waiting on the AI still reads as alive. Hidden from
             accessibility: it moves every frame inside the live region, and the title already
             says where the scan is. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/analysis_progress"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:max="100"
            app:indicatorSize="56dp"
            app:indicatorTrackGapSize="4dp"
            app:trackCornerRadius="50%"
            app:trackThickness="5dp"
            app:waveAmplitude="2dp"
            app:waveSpeed="12dp"
            app:wavelength="18dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/analysis_loading_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/reading_ingredients"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/reading_ingredients_message"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_analysis_button"
            style="@style/Widget.AllergyCheck.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cancel_analysis" />
    </LinearLayout>

    <!-- Result. No layout_* attributes here on purpose: the included root carries its own, and an
         <include> adds no wrapper view, so analysis_result stays this group's third child. -->
    <include layout="@layout/view_analysis_result" />
</LinearLayout>
