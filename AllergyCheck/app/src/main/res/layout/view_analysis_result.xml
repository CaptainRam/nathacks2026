<?xml version="1.0" encoding="utf-8"?>
<!-- The analysis result itself, extracted from view_analysis.xml so it can be rendered in two
     places: in-page under the photo on the scan page, and on the scan-history detail page. Bound
     by AnalysisResultView, which resolves every id through the root it is handed, so this layout
     can be included more than once as long as callers never reach for these ids through
     Activity#findViewById. Keep the ids and the child order as they are: both inclusion sites and
     MainActivityOcrIntegrationTest walk this subtree by id and by child index. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/analysis_result"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="vertical"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/verdict_card"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:shapeAppearance="@style/ShapeAppearance.AllergyCheck.Large"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:id="@+id/verdict_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_verdict_icon"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_check" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/verdict_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    tools:text="Contains an allergen" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/verdict_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textIsSelectable="true"
                    tools:text="The label lists: Milk." />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Always shown right under the verdict: the reading can be wrong. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/result_caution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/result_caution"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableStartCompat="@drawable/ic_info_small"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/low_confidence_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_result_note"
        android:drawablePadding="12dp"
        android:padding="14dp"
        android:text="@string/low_confidence_warning"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_info"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/allergen_section_title"
        style="@style/Widget.AllergyCheck.ResultSectionTitle"
        android:text="@string/section_allergens" />

    <LinearLayout
        android:id="@+id/allergen_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ingredients_section_title"
        style="@style/Widget.AllergyCheck.ResultSectionTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ingredients_card"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardElevation="0dp"
        app:shapeAppearance="@style/ShapeAppearance.AllergyCheck.Medium"
        app:strokeWidth="0dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ingredients_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/result_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="20dp"
        android:text="@string/disclaimer"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/result_secondary_button"
        style="@style/Widget.AllergyCheck.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        tools:text="@string/try_again" />
</LinearLayout>
