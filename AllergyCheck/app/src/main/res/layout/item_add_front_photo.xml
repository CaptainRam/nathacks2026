<?xml version="1.0" encoding="utf-8"?>
<!-- Empty second slot in the same row as the ingredient thumbnail. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:paddingHorizontal="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/front_thumbnail_add_card"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="112dp"
        android:layout_height="@dimen/photo_thumbnail_height"
        android:clickable="true"
        android:contentDescription="@string/crosscheck_add_photo"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardElevation="0dp"
        app:shapeAppearance="@style/ShapeAppearance.AllergyCheck.Medium"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/front_thumbnail_add_button"
                style="@style/Widget.AllergyCheck.TonalIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/crosscheck_add_photo"
                app:icon="@drawable/ic_add"
                app:iconSize="24dp" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/photo_role_front"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/crosscheck_photo_optional"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
