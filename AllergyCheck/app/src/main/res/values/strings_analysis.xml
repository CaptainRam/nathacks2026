<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for label analysis and the results screen. Kept in their own file so they merge
     cleanly with the home-screen strings.xml. -->
<resources>
    <string name="results_title">Label results</string>

    <!-- Banner: title + message per overall status -->
    <string name="status_contains_title">Contains an allergen</string>
    <string name="status_contains_message">The label lists: %1$s.</string>
    <string name="status_may_contain_title">May contain an allergen</string>
    <string name="status_may_contain_message">The label has a precautionary warning for: %1$s.</string>
    <string name="status_possible_title">Possible allergen — check the label</string>
    <string name="status_possible_message">Something on the label might involve: %1$s. We couldn\'t be sure, so please check the package.</string>
    <string name="status_not_detected_title">Not detected in the text read</string>
    <string name="status_not_detected_message">None of your selected allergens were found in the text that was read. This is not a guarantee the product is safe — always check the package yourself.</string>
    <string name="status_unreadable_title">Couldn\'t read this label</string>
    <string name="status_unreadable_message">Not enough text could be read to check for allergens. This is NOT a clear result. Retake a closer, well-lit photo of the ingredient list.</string>
    <string name="status_no_allergens_title">No allergens selected</string>
    <string name="status_no_allergens_message">Choose the allergens you want to check for, then analyse the label again.</string>

    <string name="low_confidence_warning">Heads up: the label text was thin or missing an \"Ingredients\" heading, so this result may be incomplete. Retaking the photo may help.</string>

    <!-- Sections -->
    <string name="section_allergens">Your allergens</string>
    <string name="section_ingredients">Ingredients read from the label</string>
    <string name="section_statements">Allergen statements</string>
    <string name="no_ingredients_found">No ingredient list could be picked out of the text.</string>
    <string name="show_raw_text">Show raw label text</string>
    <string name="hide_raw_text">Hide raw label text</string>
    <string name="retry_scan">Scan again</string>
    <string name="disclaimer">Allergy Check is an aid, not a medical device. It can misread labels. Always read the package yourself when your health depends on it.</string>

