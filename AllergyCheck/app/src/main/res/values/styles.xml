<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AllergyCheck.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">10dp</item>
    </style>
    <style name="Widget.AllergyCheck.TonalIconButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.AllergyCheck.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Widget.AllergyCheck.PhotoActionButton" parent="Widget.AllergyCheck.TonalIconButton">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="iconSize">28dp</item>
    </style>
    <style name="Widget.AllergyCheck.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">26dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">10dp</item>
    </style>
    <style name="Widget.AllergyCheck.TipRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="drawableStartCompat">@drawable/bg_tip_dot</item>
    </style>
    <style name="Widget.AllergyCheck.ResultSectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- Settings: every section is a title and one hint above a card. -->
    <style name="Widget.AllergyCheck.SettingsSectionTitle" parent="Widget.AllergyCheck.ResultSectionTitle">
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>
    <style name="Widget.AllergyCheck.SettingsSectionHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.AllergyCheck.SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AllergyCheck.Medium</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <!-- A detection mode: a title line and a one-line explanation, set in code. -->
    <style name="Widget.AllergyCheck.DetectionModeOption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="ShapeAppearance.AllergyCheck.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.AllergyCheck.Medium" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
