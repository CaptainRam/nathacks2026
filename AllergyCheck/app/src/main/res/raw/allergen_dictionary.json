        "skim milk", "whole milk", "milk powder", "milk solid", "milk protein", "milk fat",
        "milkfat", "milk", "buttermilk", "butterfat", "butter", "ice cream", "cream", "creme",
        "crema", "half and half", "cheese", "cheddar", "mozzarella", "ricotta", "parmesan",
